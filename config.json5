{
  experiment: {
    experiment_name: "meta",
    log_dir: "logs",
    seed: 20030128,
    notes: null,
    tags: null,
    use_wandb: false,
    wandb_project: "meta-transformer",
  },
  data: {
    num_workers: 5,
    persistent_workers: true,
    prefetch_factor: 4,
    pin_memory: true,
    sequential_randomness: 0.15,
    factor_randomness: 0.15,
    lookback_randomness: 0.0,
    use_cpu_preprocessing: true,
    cpu_preprocessing_workers: 32,
    distributed_cache_path: "/tmp/randomized_cache",
    feature_noise_std: 0.0,
    target_columns: ["close"],
    feature_categories: {
      price: ["1m_log_close_ret_1", "1m_log_volume_ret_1", "1m_hml_ret_1", "1m_intraday_ret_1", "1m_log_close_ret_5", "1m_log_volume_ret_5", "1m_hml_ret_5", "1m_intraday_ret_5",
        "1m_log_close_ret_15", "1m_log_volume_ret_15", "1m_hml_ret_15", "1m_intraday_ret_15", "1m_log_close_ret_60", "1m_log_volume_ret_60", "1m_hml_ret_60", "1m_intraday_ret_60", 
        "1m_std_close_15", "1m_std_volume_15", "1m_close_volume_corr_15", "1m_ret_volume_corr_15", "1m_close_dd_15", "1m_std_close_60", "1m_std_volume_60", "1m_close_volume_corr_60", 
        "1m_ret_volume_corr_60", "1m_close_dd_60", "1m_sma_5_10", "1m_sma_10_20", "1m_sma_20_60", "1m_sma_60_120", "1m_ema_5_10", "1m_ema_10_20", "1m_ema_20_60", "1m_ema_60_120", 
        "1m_macd_5_20_5", "1m_macd_12_26_9", "1m_macd_19_39_9", "1m_rsi_6", "1m_rsi_14", "1m_rsi_25", "1m_osc_K_9_3", "1m_osc_D_9_3", "1m_osc_K_14_3", "1m_osc_D_14_3", "1m_osc_K_21_5",
        "1m_osc_D_21_5", "1m_cci_10", "1m_cci_20", "1m_cci_50", "1m_fibo_r1", "1m_fibo_r2", "1m_fibo_r3", "1m_fibo_s1", "1m_fibo_s2", "1m_fibo_s3", "1m_pivot", "1m_pivot_r1", "1m_pivot_s1", 
        "1m_pivot_r2", "1m_pivot_s2", "1m_pivot_r3", "1m_pivot_s3", "1m_mfm_10", "1m_cmf_10", "1m_mfm_30", "1m_cmf_30", "1m_mfm_60", "1m_cmf_60", "1m_close_vs_vwap_10", "1m_close_vs_vwap_30", 
        "1m_close_vs_vwap_60", "1m_log_vwap_ret_1", "1m_log_vwap_ret_5", "1m_log_vwap_ret_15", "1m_log_vwap_ret_60", "1m_atr2close_1", "1m_atr2close_5", "1m_atr2close_15", "1m_atr2close_60", 
        "1m_boll_width_10", "1m_boll_width_20", "1m_boll_width_60"],
      window: ["predict_start", "predict_end"],
      meta: ["symbol", "data_type"],
      other: []
    },
    randomize_files: false,
    randomize_chunks: false,
    worker_file_pool_size: 10,
    use_preload_buffer: true,
    preload_buffer_size: 6,
    allow_cross_file_chunks: true,
    min_batch_completeness: 0.95,
    train_data_columns_mapping: {
      "data_type_mapping": { "Crypto": 1, "us_stock": 0 }
    }
  },
  model: {
    d_model: 1024,
    n_heads: 16,
    n_layers: 16,
    dropout: 0.1,
    feedforward_dim: 4096,
    activation: "gelu",
    layer_norm_eps: 1e-05,
    max_sequence_length: 4096,
    use_rope: true,
    rope_theta: 10000.0,
    use_varlen_attention: true,
    rope_scaling: null,
    use_grn: false,
    use_temporal_fusion: false,
    grn_hidden_size_multiplier: 2.0,
    use_hybrid_architecture: false,
    lstm_hidden_size: null,
    lstm_num_layers: 1,
    transformer_num_layers: 1,
    use_positional_encoding_after_lstm: false,
  },
  optimization: {
    optimizer: "adamw",
    learning_rate: 1e-05,
    weight_decay: 0.01,
    adam_beta1: 0.9,
    adam_beta2: 0.99,
    adam_eps: 1e-08,
    sgd_momentum: 0.9,
    sgd_nesterov: true,
    sgd_dampening: 0,
    scheduler: "none",
    cosine_eta_min: 0.0,
    exponential_gamma: 0.95,
    scheduler_total_steps: 10000,
    auto_lr_find: false,
  },
  training: {
    train_date_start: "2000-01-01",
    train_date_end: "2000-02-01",
    date_group_size: 7,
    date_group_lookback: 2,
    iter_every_group: 200,
    date_group_start_date: "2000-01-01",
    max_epochs: 999999,
    max_steps: 500000,
    accumulate_grad_batches: 1,
    gradient_clip_val: 5.0,
    gradient_clip_algorithm: "norm",
    precision: "bf16",
    benchmark: true,
    deterministic: false,
    detect_anomaly: false,
    accelerator: "gpu",
    devices: "auto",
    strategy: "auto",
    ddp_static_graph: true,
    use_powersgd: true,
    powersgd_rank: 16,
    powersgd_start_iter: 10,
    powersgd_min_compression_rate: 4.0,
    powersgd_use_error_feedback: true,
    powersgd_warm_start: true,
    powersgd_orthogonalization_epsilon: 1e-08,
    use_fp16_compression: false,
    enable_checkpointing: true,
    checkpoint_save_top_k: 10000,
    checkpoint_save_interval: 500,
    checkpoint_dir_name: "checkpoints",
    enable_progress_bar: true,
    enable_model_summary: true,
    log_every_n_steps: 100,
    performance_log_interval: 100,
    profiler: null,
    fast_dev_run: false,
    overfit_batches: 0.0,
    limit_train_batches: 1.0,
    use_swa: false,
    swa_lrs: 0.01,
    swa_epoch_start: 0.8,
  },
  checkpoint: {
    strict_loading: true,
    allow_shape_mismatch: false,
    adapt_positional_encoding: true,
    warn_on_missing_keys: true,
    warn_on_unexpected_keys: true,
  },
  binary_classification: {
    bce_weight: 1.0,
    focal_weight: 0.0,
    sigmoid_weight: 0.0,
    bce_pos_weight: null,
    label_smoothing: 0.0,
    focal_alpha: 0.5,
    focal_gamma: 0.5,
    sigmoid_k: 2.0,
    match_batch_distribution: false,
    total_error_weight: 0.0,
    balance_weight: 0.2,
    variance_penalty_weight: 0.0,
    max_variance: 0.25,
    target_prediction_ratio: 0.5,
    balance_loss_type: "squared",
    balance_loss_k: 1.2,
    balance_loss_gamma: 3.0,
    use_hard_fp_fn: true,
    fp_fn_temperature: 0.1,
    fp_fn_threshold: 0.5,
    target_fp_rate: 0.0,
    target_fn_rate: 0.0,
    prediction_threshold: 0.5,
    enable_adaptive_lr: false,
    lr_reduction_factor: 0.99,
    lr_patience_batches: 100,
    lr_min: 1e-08,
    lr_cooldown_batches: 50,
  },
  memory_optimization: {
    gradient_checkpointing: true,
    memory_fraction: 0.95,
    auto_batch_size_on_oom: false,
    min_batch_size: 1,
  },
  visualization: {
    enable_training_plots: true,
    plot_interval: 100,
    save_plots_to_disk: true,
    plot_dir: "logs/training_plots",
    plot_histogram_bins: 50,
    log_to_tensorboard: true,
    plot_prediction_distribution: true,
    max_samples_per_plot: 50000,
  },
  distribution_verification: {
    enable_verification: false,
    verification_interval: 100,
    variance_warning_threshold: 0.01,
    verbose: true,
    log_to_tensorboard: true,
  },
  logging: {
    level: "INFO",
  },
  pytorch_backend: {
    allow_tf32: true,
    cudnn_allow_tf32: true,
    cudnn_benchmark: true,
  },
  gradient_tracking: {
    enable_component_tracking: true,
    component_gradient_freq: 10,
    use_gradient_logger_callback: true,
    gradient_logger_interval: 50,
    log_layer_gradients: true,
    log_gradient_histograms: false,
    detect_gradient_anomalies: true,
    gradient_anomaly_threshold: 10.0,
    track_gradient_flow: true,
    display_component_gradients: true,
    component_gradient_display_freq: 10,
  },
}
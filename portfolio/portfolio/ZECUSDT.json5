{
  _base: {
    weight: 1.0,
    optimizer_weight_decay: 0.01,
    chunk_size_lines: 32768,
    file_pattern: "*_2025-*.parquet",
    batch_size: 256,
    seq_length: 512,
    sequential_samples: 512,
    exponential_factor: 1,
    min_stride: 50,
    max_stride: 200,
    normalisation: 0,
